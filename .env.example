# ─────────────────────────────────────────────────────────────────────────────
# MathBot Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Get your free API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string

# ── Database (defaults work with docker-compose) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://mathbot:mathbot@localhost:5432/mathbot

# ── Redis (defaults work with docker-compose) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Optional tuning ───────────────────────────────────────────────────────────
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.1
# RATE_LIMIT_SOLVE_PER_MINUTE=20
# RATE_LIMIT_OCR_PER_MINUTE=5
# VERIFICATION_CONFIDENCE_THRESHOLD=0.80
# MAX_IMAGE_SIZE_MB=10
